# Copy this file to .env and fill in your Azure OpenAI values.
# azure_cli reuses your existing `az login` session and does not require API keys.
AZURE_OPENAI_AUTH_MODE=azure_cli
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE-NAME.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=YOUR_VISION_MODEL_DEPLOYMENT_NAME
AZURE_OPENAI_API_VERSION=v1

# Optional: uncomment only if config.yaml uses auth_mode: api_key.
# AZURE_OPENAI_API_KEY=YOUR_API_KEY_HERE

# Optional: set when your `az login` account has access in a specific tenant.
# AZURE_TENANT_ID=YOUR_TENANT_ID
